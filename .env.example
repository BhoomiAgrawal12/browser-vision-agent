# Optional OpenAI-compatible remote planner. Leave endpoint/key blank for local-only planning.
# Local perception and form-value handling stay in the browser. Do not commit .env.

# Full chat-completions URL. Blank = deterministic local heuristic planner.
PLANNER_ENDPOINT=
# Model name sent to the endpoint. Blank falls back to "default".
PLANNER_MODEL=
# Bearer token for the endpoint, if it needs one.
PLANNER_API_KEY=
# heuristic | auto | model. Unknown values fall back to auto.
PLANNER_MODE=heuristic
# Sampling temperature, 0 to 2. Out-of-range values fall back to 0.
PLANNER_TEMPERATURE=0
# Remote request timeout in milliseconds. Must be positive.
PLANNER_TIMEOUT_MS=30000
# Optional: local planner server port (defaults to 8787).
# PORT=8787
